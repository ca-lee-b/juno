# Shared by API and worker. Local development credentials only.
DATABASE_URL=postgres://agent:agent@localhost:5432/pr_agent
REDIS_URL=redis://localhost:6379
API_TOKEN=replace-with-a-random-token-at-least-32-characters
PORT=3000
LOG_LEVEL=info

# Required only by the worker. Only the dedicated OpenAI key is supplied to Codex inside Daytona.
OPENAI_API_KEY=
OPENAI_CODEX_MODEL=gpt-6-astra
OPENAI_CODEX_MODEL_EFFORT=medium
OPENAI_WRITEUP_MODEL=gpt-6-luna
OPENAI_WRITEUP_MODEL_EFFORT=high
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# Shared by API and worker: fine-grained token with Contents: read and Issues: read for browsing. Draft PR publishing also needs Contents: write and Pull requests: write.
# Required for repository browsing and private repositories; never sent to the agent.
GITHUB_TOKEN=
WORKER_CONCURRENCY=2
AGENT_TIMEOUT_MS=600000
